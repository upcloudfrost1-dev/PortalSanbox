    return out
end
local function scanAll()
    local out, seen = {}, {}
    local function add(list) for _, t in ipairs(list) do if not seen[t.Char] then seen[t.Char]=true; table.insert(out,t) end end end
    local m = Settings.TargetMode
    if m=="ALL" or m=="PLAYERS" then add(scanPlayers()) end
    if m=="ALL" or m=="CREATURES" then add(scanCreatures()) end
    if m=="ALL" or m=="RICKS" then add(scanRicks()) end
    if m=="ALL" or m=="NPCS" then add(scanNPCs()) end
    return out
end
local CachedTargets, LastScanTime = {}, 0
local function scanCached()
    if tick() - LastScanTime < 0.04 then return CachedTargets end
    CachedTargets = scanAll(); LastScanTime = tick(); return CachedTargets
end

-- ==========================================
-- VELOCITY + PREDICTION
-- ==========================================
local LastPositions = {}
local function updateVelocities(tracked)
    local now = tick()
    for _, t in ipairs(tracked) do
        local old = LastPositions[t.Char]
        local v
        if old then
            local dt = math.max(now - old.time, 0.02)
            v = (t.HRP.Position - old.pos) / dt
            if v.Magnitude > 200 then v = v.Unit * 200 end
        else
            v = Vector3.new()
        end
        -- Blend with physics velocity if available
        local physV = t.HRP.AssemblyLinearVelocity
        if physV and physV.Magnitude > v.Magnitude then
            v = v:Lerp(physV, 0.4)
        end
        t.Velocity = v
        LastPositions[t.Char] = { pos = t.HRP.Position, time = now }
    end
end

local function getAimPart(t)
    if Settings.AimPart == "Head" then return t.Char:FindFirstChild("Head") or t.HRP end
    if Settings.AimPart == "Both (Random)" and math.random() < 0.5 then return t.Char:FindFirstChild("Head") or t.HRP end
    return t.HRP
end

local function predictAimPos(t, aimPart)
    if not Settings.Predict or not t.Velocity or t.Velocity.Magnitude < 5 then return aimPart.Position end
    local predictedHRP = t.HRP.Position + t.Velocity * Settings.LeadTime
    return predictedHRP + (aimPart.Position - t.HRP.Position)
end

-- ==========================================
-- FIRE WEAPON (with dir mode + burst + HeldSync sync)
-- ==========================================
local lastPayload = ""

local function fireWeapon(targetInfo)
    if not targetInfo or not targetInfo.Char or not targetInfo.Char.Parent then return false,"no target" end
    if not targetInfo.Hum or targetInfo.Hum.Health <= 0 then return false,"dead" end
    local weaponKey = getActiveWeaponKey()
    if not weaponKey then return false,"no weapon" end
    local data = RemoteData[weaponKey]; if not data then return false,"bad weapon" end
    local remote = findRemote(data.RemoteName)
    if not remote then log("REMOTE MISSING: "..data.RemoteName); return false,"no remote" end
    autoEquip(weaponKey)
    local origin = getFireOrigin(); if not origin then return false,"no origin" end

    local aimPart = getAimPart(targetInfo)
    local aimPos = predictAimPos(targetInfo, aimPart)
    local delta = aimPos - origin
    if delta.Magnitude < 0.01 then delta = Vector3.new(0,0,1) end

    -- Direction based on mode
    local dir
    if Settings.DirectionMode == "RAW" then
        dir = delta -- full displacement (origin + dir = aimPos exactly)
    else
        dir = delta.Unit -- unit direction
    end

    local floorPart = findFloorPart(aimPos, targetInfo.Char)

    if weaponKey == "HomingLauncher" then
        local rr = findRemote("GunReload")
        if rr then fireArgs(rr, {"HomingLauncher"}, 1) end
    end

    -- HeldSync burst BEFORE weapon (3x, tight, same frame)
    if Settings.SyncAim then
        local hs = findRemote("HeldSync")
        if hs then
            for _ = 1, 3 do
                fireArgs(hs, {"aim", delta.Unit}, 2)
            end
        end
    end

    local args = {}
    for i=1,data.ArgCount do
        local k = data.Arguments[i]
        if k==nil then args[i]=nil
        elseif k=="fire" or k=="use" or k=="aim" then args[i]=k
        elseif k=="OriginVector3" then args[i]=origin
        elseif k=="DirectionVector3" then args[i]=dir
        elseif k=="TargetPosVector3" then args[i]=aimPos
        elseif k=="FloorPart" then args[i]=floorPart
        elseif k=="CharacterModel" then args[i]=LocalPlayer.Character
        else args[i]=k end
    end

    -- Fire weapon BurstCount times (all in same frame)
    local ok, err
    for i=1, Settings.BurstCount do
        ok, err = fireArgs(remote, args, data.ArgCount)
    end

    -- Save payload for debug
    lastPayload = string.format(
        "%s | origin=(%.1f,%.1f,%.1f) aim=(%.1f,%.1f,%.1f) dirMag=%.1f",
        weaponKey, origin.X, origin.Y, origin.Z, aimPos.X, aimPos.Y, aimPos.Z, dir.Magnitude)

    return ok, ok and "ok" or "rejected"
end

-- ==========================================
-- FIRE HEAL (Plumbus on self)
-- ==========================================
local function fireHeal()
    local char = LocalPlayer.Character; if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health <= 0 then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return false end
    local remote = findRemote("ItemEvent"); if not remote then return false,"no remote" end
    local origin = getFireOrigin() or hrp.Position
    local targetPos = hrp.Position
    local dir = targetPos - origin
    if dir.Magnitude < 0.01 then dir = Vector3.new(0,0,1) else dir = dir.Unit end
    return fireArgs(remote, {"use","Plumbus",dir,char,targetPos}, 5)
end

local lastHeal = 0
local function checkAutoHeal()
    if not Settings.HealEnabled then return end
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health <= 0 then return end
    local pct = (hum.Health / math.max(hum.MaxHealth,1)) * 100
    if pct > Settings.HealThreshold then return end
    if tick() - lastHeal < Settings.HealCooldown then return end
    if fireHeal() then lastHeal = tick(); log("Auto-heal @ "..math.floor(pct).."%") end
end

