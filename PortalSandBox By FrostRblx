    for _, t in ipairs(tracked) do validSet[t.Char] = t end
    for model, _ in pairs(ESPs) do
        if not validSet[model] or not Settings.ESPEnabled then destroyESP(model) end
    end

    if Settings.ESPEnabled then
        for _, t in ipairs(tracked) do
            if not ESPs[t.Char] then buildESP(t) end
            local e = ESPs[t.Char]
            if e then
                local worldPos = t.HRP.Position + Vector3.new(0, 1.5, 0)
                local pos, onScreen = Camera:WorldToViewportPoint(worldPos)
                if onScreen and pos.Z > 0 then
                    local distToCam = (worldPos - Camera.CFrame.Position).Magnitude
                    local scale = math.clamp(60 / math.max(distToCam, 6), 0.35, 1.6)
                    local hpW = math.max(3, math.floor(4 * scale))
                    local hpH = math.max(20, math.floor(60 * scale))
                    e.hpBar.Size = UDim2.new(0, hpW, 0, hpH)
                    e.hpBar.Position = UDim2.new(0, pos.X - math.floor(8*scale), 0, pos.Y)
                    e.hpBar.Visible = true
                    local pct = math.clamp(t.Hum.Health / math.max(t.Hum.MaxHealth,1), 0, 1)
                    e.hpFill.Size = UDim2.new(1,0,pct,0)

                    local d = localHRP and (t.HRP.Position - localHRP.Position).Magnitude or 0
                    local lsTxt = ""
                    if t.Player then
                        local ls = t.Player:FindFirstChild("leaderstats")
                        if ls then
                            for _, stat in ipairs(ls:GetChildren()) do
                                lsTxt = lsTxt .. "\n "..stat.Name..": "..tostring(stat.Value)
                            end
                        end
                    end
                    e.statsLabel.Text = string.format("▌ %s [%s]\n ❤ %d/%d\n ◆ %.0fm%s",
                        string.sub(t.Name,1,16), t.Type,
                        math.floor(t.Hum.Health), math.floor(t.Hum.MaxHealth), d, lsTxt)
                    e.statsLabel.TextSize = math.clamp(math.floor(11*scale), 7, 14)
                    e.statsLabel.Size = UDim2.new(0, math.floor(200*scale), 0, math.floor(100*scale))
                    e.statsLabel.Position = UDim2.new(0, pos.X + math.floor(6*scale), 0, pos.Y)
                    e.statsLabel.Visible = true

                    if Settings.TraceEnabled and localHRP then
                        local p1 = Camera:WorldToViewportPoint(localHRP.Position + Vector3.new(0,1,0))
                        if p1.Z > 0 then
                            local a = Vector2.new(p1.X, p1.Y)
                            local b = Vector2.new(pos.X, pos.Y)
                            local mid = (a+b)*0.5
                            local v = b-a
                            local len = v.Magnitude
                            local ang = math.deg(math.atan2(v.Y, v.X))
                            e.tLine.Position = UDim2.new(0, mid.X, 0, mid.Y)
                            e.tLine.Size = UDim2.new(0, len, 0, 2)
                            e.tLine.Rotation = ang; e.tLine.Visible = true
                            e.tLineGlow.Position = UDim2.new(0, mid.X, 0, mid.Y)
                            e.tLineGlow.Size = UDim2.new(0, len, 0, 8)
                            e.tLineGlow.Rotation = ang; e.tLineGlow.Visible = true
                        else
                            e.tLine.Visible = false; e.tLineGlow.Visible = false
                        end
                    else
                        e.tLine.Visible = false; e.tLineGlow.Visible = false
                    end
                else
                    e.hpBar.Visible = false; e.statsLabel.Visible = false
                    e.tLine.Visible = false; e.tLineGlow.Visible = false
                end
            end
        end
    end

    if currentCategory and currentCategory.Name == "Status" then
        local s = contentScroller:FindFirstChild("StatusValue")
        if s then
            if Settings.AutoFire then
                s.Text = string.format("%s → %s [%s] | targets: %d | origin:%s dir:%s burst:%dx",
                    weaponDisplayName(), lastTargetName, lastFireResult, lastTargetsInRange,
                    Settings.OriginMode, Settings.DirectionMode, Settings.BurstCount)
                s.TextColor3 = C_WHITE
            else
                s.Text = "IDLE | targets: "..lastTargetsInRange
                s.TextColor3 = C_GRAY
            end
        end
        local dbg = contentScroller:FindFirstChild("DebugLog")
        if dbg then
            local txt = ""
            for i = 1, math.min(#DebugLines, 12) do txt = txt..DebugLines[i].."\n" end
            dbg.Text = txt
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if mainFrame.Visible then hideBtn:FireMouseButton1Click() else openBtn:FireMouseButton1Click() end
    end
end)
