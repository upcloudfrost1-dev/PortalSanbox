local RemoteCache = {}
local function findRemote(name)
    local c = RemoteCache[name]; if c and c.Parent then return c end
    for _, root in ipairs({ReplicatedStorage, Workspace}) do
        local d = root:FindFirstChild(name)
        if d and (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then RemoteCache[name]=d; return d end
    end
    for _, root in ipairs({ReplicatedStorage, Workspace, LocalPlayer}) do
        local deep = root:FindFirstChild(name, true)
        if deep and (deep:IsA("RemoteEvent") or deep:IsA("RemoteFunction")) then RemoteCache[name]=deep; return deep end
    end
    return nil
end

local function fireArgs(remote, args, count)
    if not remote then return false end
    return pcall(function()
        if remote:IsA("RemoteEvent") then
            if count==1 then remote:FireServer(args[1])
            elseif count==2 then remote:FireServer(args[1],args[2])
            elseif count==3 then remote:FireServer(args[1],args[2],args[3])
            elseif count==4 then remote:FireServer(args[1],args[2],args[3],args[4])
            elseif count==5 then remote:FireServer(args[1],args[2],args[3],args[4],args[5]) end
        elseif remote:IsA("RemoteFunction") then
            if count==1 then remote:InvokeServer(args[1])
            elseif count==2 then remote:InvokeServer(args[1],args[2])
            elseif count==3 then remote:InvokeServer(args[1],args[2],args[3])
            elseif count==4 then remote:InvokeServer(args[1],args[2],args[3],args[4])
            elseif count==5 then remote:InvokeServer(args[1],args[2],args[3],args[4],args[5]) end
        end
    end)
end

local function norm(s) return string.lower((s:gsub("%s+",""))) end
local function toolMatches(tName, key)
    local t,k = norm(tName), norm(key)
    return t:find(k,1,true)~=nil or k:find(t,1,true)~=nil
end

local function autoEquip(weaponKey)
    if not Settings.AutoEquip or weaponKey=="ALL" or weaponKey=="Plumbus" then return end
    local char = LocalPlayer.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local eq = char:FindFirstChildOfClass("Tool")
    if eq and toolMatches(eq.Name, weaponKey) then return end
    local bp = LocalPlayer:FindFirstChild("Backpack"); if not bp then return end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and toolMatches(t.Name, weaponKey) then
            pcall(function() hum:EquipTool(t) end); return
        end
    end
end

-- ==========================================
-- ORIGIN (with mode toggle)
-- ==========================================
local function getFireOrigin()
    local char = LocalPlayer.Character; if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    local mode = Settings.OriginMode
    if mode == "CAMERA" then return Camera.CFrame.Position end
    if mode == "HRP" then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position end
    end
    if mode == "HEAD" then
        local head = char:FindFirstChild("Head")
        if head then return head.Position end
    end
    -- HANDLE mode (default): tool handle, fallback to head
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        local h = tool:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then
            return h.Position + h.CFrame.LookVector * 0.5
        end
    end
    local head = char:FindFirstChild("Head")
    if head then return head.Position end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    return nil
end

local function findFloorPart(pos, tChar)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local ex = {}
    if LocalPlayer.Character then table.insert(ex, LocalPlayer.Character) end
    if tChar then table.insert(ex, tChar) end
    rp.FilterDescendantsInstances = ex
    local hit = Workspace:Raycast(pos + Vector3.new(0,3,0), Vector3.new(0,-200,0), rp)
    if hit and hit.Instance and hit.Instance:IsA("BasePart") then return hit.Instance end
    local dims = Workspace:FindFirstChild("Dimensions")
    if dims then
        for _, dim in ipairs(dims:GetChildren()) do
            local u = dim:FindFirstChild("Universe")
            local c = u and u:FindFirstChild("Colliders")
            local ft = c and c:FindFirstChild("FloorTiles")
            local f = ft and ft:FindFirstChild("Floor")
            if f and f:IsA("BasePart") then return f end
            local room = dim:FindFirstChild("Room")
            local rf = room and room:FindFirstChild("Floor")
            if rf and rf:IsA("BasePart") then return rf end
        end
        local bp = dims:FindFirstChild("Baseplate")
        local dk = bp and bp:FindFirstChild("Dark Mode Baseplate")
        if dk and dk:IsA("BasePart") then return dk end
    end
    return nil
end

