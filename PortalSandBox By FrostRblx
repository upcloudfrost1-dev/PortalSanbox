local function scanNPCs()
    local out = {}; local npcs = Workspace:FindFirstChild("NPCs"); if not npcs then return out end
    for _, lifeFolder in ipairs(npcs:GetChildren()) do
        for _, npc in ipairs(lifeFolder:GetChildren()) do
            local hum = npc:FindFirstChildOfClass("Humanoid")
            local hrp = npc:FindFirstChild("HumanoidRootPart")
