-- ==========================================
-- AUTO-FIRE + HEAL LOOP
-- ==========================================
local lastFire = 0
local lastTargetName = "-"
local lastTargetsInRange = 0
local lastFireResult = ""

RunService.Heartbeat:Connect(function()
    checkAutoHeal()
    local tracked = scanCached()
    updateVelocities(tracked)
    lastTargetsInRange = #tracked
    if not Settings.AutoFire then return end

    local char = LocalPlayer.Character; if not char then return end
    local origin = getFireOrigin(); if not origin then return end

    local best, bestDist = nil, math.huge
    for _, t in ipairs(tracked) do
        local d = (t.HRP.Position - origin).Magnitude
        if d <= Settings.MaxDistance and d < bestDist then
            local ok = true
            if Settings.WallCheck then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {char, t.Char}
                local hit = Workspace:Raycast(origin, t.HRP.Position - origin, rp)
                if hit and (hit.Position - t.HRP.Position).Magnitude > 3 then ok = false end
            end
            if ok then best, bestDist = t, d end
        end
    end

    if not best then lastTargetName="-"; lastFireResult="no target"; return end

    if tick() - lastFire >= Settings.FireCooldown then
        local ok, reason = fireWeapon(best)
        lastFire = tick()
        lastTargetName = best.Name
        lastFireResult = ok and "OK" or tostring(reason)
        if not ok then log("FIRE "..tostring(getActiveWeaponKey()).." -> "..best.Name.." : "..tostring(reason)) end
    end
end)

