local ORDER = 0
local function nextOrder() ORDER = ORDER + 1; return ORDER end

local function makeContentBtn(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,40); btn.BackgroundColor3 = C_DARK
    btn.BackgroundTransparency = 0.15; btn.BorderSizePixel = 0
    btn.Text = text; btn.TextColor3 = C_WHITE; btn.TextScaled = true
    btn.Font = Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false; btn.Active = true
    btn.LayoutOrder = nextOrder(); btn.Parent = contentScroller
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    applyStroke(btn, C_WHITE, 1, 0.75)
    local pad = Instance.new("UIPadding", btn)
    pad.PaddingLeft = UDim.new(0,14); pad.PaddingRight = UDim.new(0,14)
    limitTextSize(btn, 14)
    btn.MouseEnter:Connect(function() playSFX("Hover"); tween(btn,{BackgroundColor3=C_MID,BackgroundTransparency=0.05},0.15) end)
    btn.MouseLeave:Connect(function() tween(btn,{BackgroundColor3=C_DARK,BackgroundTransparency=0.15},0.15) end)
    btn.MouseButton1Click:Connect(function() playSFX("Click"); callback(btn) end)
    return btn
end

local function weaponDisplayName()
