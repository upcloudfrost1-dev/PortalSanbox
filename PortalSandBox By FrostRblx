local function scanPlayers()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                table.insert(out, {Name=p.Name, Char=p.Character, Hum=hum, HRP=hrp, Type="Player", Velocity=Vector3.new(), Player=p})
            end
        end
    end
    return out
end
local function scanCreatures()
    local out = {}; local folder = Workspace:FindFirstChild("Creatures")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            local hum = m:FindFirstChildOfClass("Humanoid")
            local hrp = m:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                table.insert(out, {Name=m.Name, Char=m, Hum=hum, HRP=hrp, Type="Creature", Velocity=Vector3.new()})
            end
        end
    end
    return out
end
local function scanRicks()
    local out = {}; local c = Workspace:FindFirstChild("Citadel")
    local folder = c and c:FindFirstChild("Ricks")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
